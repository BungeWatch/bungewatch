# Copy this file to .env and fill in real values. Never commit .env.

# Postgres — asyncpg driver
DATABASE_URL=postgresql+asyncpg://bungewatch:password@localhost:5432/bungewatch

# AI model provider (fill in whichever you settle on — see Open Decisions in the spec)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# OCR (only needed if using a paid engine alongside Tesseract)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=af-south-1

# App
ENVIRONMENT=development
